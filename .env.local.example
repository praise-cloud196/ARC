# Neon Postgres connection string. Never commit the real value.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# IANA timezone name. Single timezone for the whole product (architecture-and-ux-v1.0.md §2.5).
# Required — there is no default. A wrong guess would mislabel every
# logical_day permanently, so an example value that happens to work is an
# example value that ships. Set the real zone in .env.local.
ARC_TIMEZONE=

# Passphrase encrypting scripts/backup.ts's dumps (AES-256-GCM, see
# scripts/backup-crypto.ts). Required to run `npm run backup` /
# `npm run restore`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means losing the backups (README.md "Backups") — keep a copy
# somewhere other than this file.
ARC_BACKUP_KEY=

# Where scripts/backup.ts writes dumps. Optional — defaults to a
# OneDrive-synced folder (~/OneDrive/arc-backups) so backups survive this
# machine dying (docs/milestone-3-spec.md §0.1). Uncomment only to override,
# e.g. if OneDrive isn't available or you want a different synced location —
# leaving this blank (rather than omitted) would defeat the default below.
# ARC_BACKUP_DIR=
