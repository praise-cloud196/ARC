# Neon Postgres connection string. Never commit the real value. In
# .env.local this must point at the `dev` branch, never `main` (real data)
# — see ARC_PRODUCTION_BRANCH_ID below, which is what actually enforces
# that (docs/milestone-4.1-fixes.md §1).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The `main` (production) Neon branch's id — e.g. `br-xxxxxxxx`, found in
# the Neon console or by querying `SELECT current_setting('neon.branch_id')`
# against it. Once set, scripts/backup.ts, scripts/restore.ts,
# scripts/rebuild.ts, scripts/boundary-job.ts, scripts/migrate.ts, and the
# whole test suite (lib/db-guard.ts) all refuse to run against a database
# with this branch id, whichever env var pointed them at it — set the same
# value here as in .env.production so dev-side tooling recognizes and
# refuses production even if DATABASE_URL is ever misconfigured to point
# there by mistake.
ARC_PRODUCTION_BRANCH_ID=

# Deliberately not a casual flag (same pattern as
# ARC_ALLOW_DESTRUCTIVE_MIGRATION) — set this to 1 only in the environment
# of something that legitimately must run against production: the
# scheduled production backup job, a deliberate one-off production
# migration. Never set it in .env.local, and never in the deployed app's
# own environment (the running app isn't guarded at all — see
# lib/db-guard.ts).
# ARC_ALLOW_PRODUCTION_WRITE=

# IANA timezone name. Single timezone for the whole product (architecture-and-ux-v1.0.md §2.5).
# Required — there is no default. A wrong guess would mislabel every
# logical_day permanently, so an example value that happens to work is an
# example value that ships. Set the real zone in .env.local.
ARC_TIMEZONE=

# Passphrase encrypting scripts/backup.ts's dumps (AES-256-GCM, see
# scripts/backup-crypto.ts). Required to run `npm run backup` /
# `npm run restore`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means losing the backups (README.md "Backups") — keep a copy
# somewhere other than this file.
ARC_BACKUP_KEY=

# Where scripts/backup.ts writes dumps. Optional — defaults to a
# OneDrive-synced folder (~/OneDrive/arc-backups) so backups survive this
# machine dying (docs/milestone-3-spec.md §0.1). Uncomment only to override,
# e.g. if OneDrive isn't available or you want a different synced location —
# leaving this blank (rather than omitted) would defeat the default below.
# ARC_BACKUP_DIR=

# Local hour (0-23) Today switches to its Night state (PRD §12.3). Optional
# — defaults to 20. A presentation choice only, so unlike ARC_TIMEZONE it's
# safe to default.
# ARC_DISPLAY_HOUR=

# Shared secret Vercel Cron sends as a bearer token when it calls
# /api/cron/boundary (vercel.json). Required only in production deploys —
# scripts/boundary-job.ts (local/manual use) doesn't check it.
# CRON_SECRET=
