# Template only — the real .env.production is never committed (.gitignore).
#
# docs/milestone-4.1-fixes.md §1: `main` holds real data and is never
# written to by a test, a script, or an agent — only the running app (in
# deployment, this is Vercel's own environment variables, not this file;
# this file is for anything run locally against production deliberately,
# e.g. a one-off production migration or a manual backup).

# The `main` (production) Neon branch's connection string.
DATABASE_URL=postgres://user:password@host/main-branch-dbname?sslmode=require

ARC_TIMEZONE=

# Same value as ARC_PRODUCTION_BRANCH_ID in .env.local.example's comment —
# this IS that branch, so lib/db-guard.ts's check will match and refuse
# every guarded script by default. ARC_ALLOW_PRODUCTION_WRITE=1 below is
# what makes deliberately running one of them here actually work.
ARC_PRODUCTION_BRANCH_ID=

# Deliberately set here, permanently — this file's whole purpose is
# "things meant to run against production." Never copy this into
# .env.local.
ARC_ALLOW_PRODUCTION_WRITE=1

ARC_BACKUP_KEY=
CRON_SECRET=
